---
// Decorative bats that swoop back and forth across the hero background.
const bats = [
  { top: "12%", left: "8%", flyX: 55, flyY: 10, scale: 0.9, duration: 13, delay: 0 },
  { top: "22%", left: "70%", flyX: -60, flyY: 14, scale: 1.15, duration: 17, delay: 2 },
  { top: "38%", left: "30%", flyX: 40, flyY: -12, scale: 0.7, duration: 11, delay: 4.5 },
  { top: "8%", left: "45%", flyX: -35, flyY: 16, scale: 0.6, duration: 15, delay: 1.2 },
  { top: "30%", left: "85%", flyX: -50, flyY: -10, scale: 1, duration: 19, delay: 6 },
  { top: "55%", left: "15%", flyX: 45, flyY: -14, scale: 0.8, duration: 14, delay: 3.5 },
  { top: "65%", left: "60%", flyX: -40, flyY: 12, scale: 1.05, duration: 16, delay: 5.5 },
  { top: "15%", left: "92%", flyX: -55, flyY: 15, scale: 0.75, duration: 12, delay: 8 },
];
---

<div class="flying-bats" aria-hidden="true">
  {
    bats.map((bat) => (
      <span
        class="bat-fly"
        style={`top:${bat.top}; left:${bat.left}; --fly-x:${bat.flyX}vw; --fly-y:${bat.flyY}vh; --scale:${bat.scale}; animation-duration:${bat.duration}s; animation-delay:${bat.delay}s;`}
      >
        <img class="bat-flap" src="/bat-flap.gif" alt="" width="80" height="43" />
      </span>
    ))
  }
</div>

<style>
  .flying-bats {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 3;
  }

  .bat-fly {
    position: absolute;
    display: block;
    width: calc(28px * var(--scale));
    animation-name: bat-path;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  .bat-flap {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 6px rgba(179, 120, 245, 0.75)) drop-shadow(0 0 12px rgba(154, 99, 214, 0.45))
      drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6));
  }

  @keyframes bat-path {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(calc(var(--fly-x) * 0.45), calc(var(--fly-y) * -0.7)) rotate(-8deg);
    }
    50% {
      transform: translate(calc(var(--fly-x) * 0.6), calc(var(--fly-y) * 0.3)) rotate(5deg);
    }
    75% {
      transform: translate(calc(var(--fly-x) * 0.85), calc(var(--fly-y) * -0.5)) rotate(-6deg);
    }
    100% {
      transform: translate(var(--fly-x), var(--fly-y)) rotate(3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bat-fly {
      animation: none;
    }
  }
</style>
