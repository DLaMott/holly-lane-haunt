---
// Two glowing carved pumpkins flanking a hero-band section.
const LOBES = 6;
const R = 34;
const BUMP = 5;
const SAMPLES = 48;
const CY = 46;

function bodyPath(): string {
  const pts = Array.from({ length: SAMPLES }, (_, i) => {
    const theta = (i / SAMPLES) * Math.PI * 2;
    const radius = R + BUMP * Math.cos(LOBES * theta);
    const x = 40 + radius * Math.sin(theta) * 0.92;
    const y = CY + radius * Math.cos(theta) * 0.8;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  return `M${pts.join(" L")} Z`;
}

const body = bodyPath();

const lanterns = [
  { style: "left: 1vw; bottom: 0.5rem;", size: 78, delay: 0 },
  { style: "right: 1vw; bottom: 0.5rem;", size: 78, delay: 1.6 },
];
---

<div class="jack-o-lanterns" aria-hidden="true">
  {
    lanterns.map((lantern, i) => (
      <svg
        class="jack"
        style={`${lantern.style} width:${lantern.size}px; animation-delay:${lantern.delay}s;`}
        viewBox="0 0 80 80"
      >
        <defs>
          <radialGradient id={`jack-aura-${i}`} cx="50%" cy="60%" r="55%">
            <stop offset="0%" stop-color="#ff8b3d" stop-opacity="0.6" />
            <stop offset="45%" stop-color="#ff6a1a" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#ff6a1a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle class="jack__aura" cx="40" cy="48" r="42" fill={`url(#jack-aura-${i})`} />
        <path class="jack__body" d={body} />
        <rect class="jack__stem" x="35" y="4" width="10" height="12" rx="2" transform="rotate(-8 40 10)" />
        <g class="jack__glow">
          <path d="M28,40 L34,52 L22,52 Z" />
          <path d="M52,40 L58,52 L46,52 Z" />
          <path d="M27,58 L34,64 L40,58 L46,64 L53,58 L48,70 L32,70 Z" />
        </g>
      </svg>
    ))
  }
</div>

<style>
  .jack-o-lanterns {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }

  .jack {
    position: absolute;
    height: auto;
  }

  .jack__aura {
    animation: jack-flicker 4.5s ease-in-out infinite;
    transform-origin: center;
  }

  .jack__body {
    fill: #1c0f06;
    stroke: rgba(255, 139, 61, 0.3);
    stroke-width: 1;
  }

  .jack__stem {
    fill: #2e2410;
  }

  .jack__glow {
    fill: var(--color-pumpkin-bright);
    animation: jack-flicker 4.5s ease-in-out infinite;
  }

  @keyframes jack-flicker {
    0%,
    100% {
      opacity: 1;
    }
    45% {
      opacity: 0.92;
    }
    52% {
      opacity: 0.6;
    }
    68% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jack__aura,
    .jack__glow {
      animation: none;
    }
  }
</style>
