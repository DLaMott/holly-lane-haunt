---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  number: number;
  name: string;
  description: string;
  image?: ImageMetadata;
}

const { number, name, description, image } = Astro.props as Props;
---

<article class:list={["scene-card", { "scene-card--photo": Boolean(image) }]}>
  {
    image && (
      <div class="scene-card__photo">
        <Image src={image} alt={`${name} scene at The Holly Lane Haunt`} width={460} height={320} loading="lazy" />
      </div>
    )
  }
  <div class="scene-card__body">
    <p class="scene-card__number" aria-hidden="true">{String(number).padStart(2, "0")}</p>
    <h3 class="scene-card__name">{name}</h3>
    <p class="scene-card__desc">{description}</p>
  </div>
</article>

<style>
  .scene-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-card);
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .scene-card:hover {
    border-color: var(--color-pumpkin);
    transform: translateY(-3px);
  }

  .scene-card__body {
    padding: 1.5rem;
  }

  .scene-card__photo {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .scene-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scene-card__number {
    font-family: var(--font-display);
    font-size: 2.75rem;
    color: var(--color-blood-bright);
    margin: 0 0 0.25rem;
    line-height: 1;
  }

  .scene-card__name {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .scene-card__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    white-space: pre-line;
  }
</style>
