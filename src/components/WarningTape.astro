---
// Hazard tape re-skinned as a torn warning banner, for flagging intense content.
interface Props {
  text?: string;
}

const { text = "CAUTION — INTENSE SCARES AHEAD" } = Astro.props as Props;
---

<div class="warning-tape" aria-hidden="true">
  <div class="warning-tape__strip">
    <span>{text}</span>
    <span>{text}</span>
    <span>{text}</span>
  </div>
</div>

<style>
  .warning-tape {
    transform: rotate(-1.1deg);
    margin-block: 1.5rem;
  }

  .warning-tape__strip {
    display: flex;
    gap: 2.5rem;
    overflow: hidden;
    background: repeating-linear-gradient(
      45deg,
      var(--color-blood) 0px 18px,
      #14100a 18px 36px
    );
    padding-block: 0.6rem;
    clip-path: polygon(
      0% 25%, 2% 0%, 6% 20%, 10% 2%, 96% 0%, 100% 22%,
      98% 100%, 94% 82%, 4% 100%, 0% 78%
    );
  }

  .warning-tape__strip span {
    flex: none;
    font-family: var(--font-body);
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #f4ede2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
    padding-inline: 1.25rem;
  }
</style>
