---
import BaseLayout from "../layouts/BaseLayout.astro";
import FogOverlay from "../components/FogOverlay.astro";
import JackOLanterns from "../components/JackOLanterns.astro";
import FaqItem from "../components/FaqItem.astro";
import { faqs } from "../data/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQs"
  description="Frequently asked questions about The Holly Lane Haunt: cost, kid-friendliness, parking, accessibility, and what to expect."
  jsonLd={jsonLd}
>
  <section class="section hero-band">
    <FogOverlay />
    <JackOLanterns />
    <div class="container">
      <div class="hero-band__intro">
        <div class="hero-band__copy">
          <p class="eyebrow">Good To Know</p>
          <h1>Frequently Asked Questions</h1>
          <p class="section-lead">Everything you need to know before you visit. Still have a question? Reach out on Facebook.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container faq-list">
      {faqs.map((faq) => <FaqItem question={faq.question} answer={faq.answer} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 6rem;
  }

  .hero-band .container {
    position: relative;
    z-index: 1;
  }

  .hero-band__intro {
    position: relative;
  }

  .hero-band__copy {
    position: relative;
    z-index: 1;
  }

  .faq-list {
    max-width: 780px;
  }
</style>
