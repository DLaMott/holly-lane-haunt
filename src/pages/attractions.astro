---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FogOverlay from "../components/FogOverlay.astro";
import JackOLanterns from "../components/JackOLanterns.astro";
import StatBadge from "../components/StatBadge.astro";
import SceneCard from "../components/SceneCard.astro";
import WarningTape from "../components/WarningTape.astro";
import { stats, scenes } from "../data/site";

import crowley from "../assets/scenes/crowley.png";
import witch from "../assets/scenes/witch.png";
import house_horror from "../assets/scenes/house_horror.png";
import woods from "../assets/scenes/woods.png";
import graveside from "../assets/scenes/graveside.png";
import spider from "../assets/scenes/spider.png";
import electrocution from "../assets/scenes/electrocution.png";
import derry from "../assets/scenes/derry.png";
import ringmaster from "../assets/scenes/ringmaster.png";
import insidious from "../assets/scenes/insidious.png";
import gabes from "../assets/scenes/gabes.png";
import lamott_industries from "../assets/scenes/lamott_industries.png";
import new_scene from "../assets/scenes/new_scene.png";

const sceneImages: Record<string, ImageMetadata> = {
  crowley,
  witch,
  house_horror,
  woods,
  graveside,
  spider,
  electrocution,
  derry,
  ringmaster,
  insidious,
  gabes,
  lamott_industries,
  new_scene,
};
---

<BaseLayout
  title="Attractions"
  description="14 scenes, 100+ animatronics, and 30+ live scarers. Explore what's waiting on The Holly Lane Haunt trail."
>
  <section class="section hero-band">
    <FogOverlay />
    <JackOLanterns />
    <div class="container">
      <div class="hero-band__intro">
        <div class="hero-band__copy">
          <p class="eyebrow">The Trail</p>
          <h1>14 Scenes. Zero <span class="hero-band__accent">Mercy</span>.</h1>
          <p class="section-lead">
            From a gentle welcome to a full-blown gauntlet of animatronics and live scarers, here's what
            awaits on the trail.
          </p>
        </div>
      </div>
      <div class="grid grid--stats stats-block">
        {stats.map((stat) => <StatBadge label={stat.label} value={stat.value} />)}
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <div class="grid grid--2">
        <div class="card trail-card">
          <h3>🎃 Front Trail</h3>
          <p>
            A friendlier, well-lit stretch built with younger trick-or-treaters in mind, plus a
            dedicated inflatable trail just for the little ones. A gentle place to start, if you're
            planning on stopping there.
          </p>
        </div>
        <div class="card trail-card trail-card--intense">
          <h3>🔪 Back Trail</h3>
          <p>
            This is where the trail stops being polite: fog, strobes, tight spaces, and scarers who
            don't break character. Not recommended for young children, or anyone who scares easily.
          </p>
        </div>
      </div>
      <WarningTape text="CAUTION — BACK TRAIL AHEAD — NOT FOR THE FAINT OF HEART" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Scene By Scene</p>
      <h2>What's Waiting For You</h2>
      <div class="grid grid--scenes">
        {scenes.map((scene) => (
          <SceneCard
            number={scene.number}
            name={scene.name}
            description={scene.description}
            image={scene.photoKey ? sceneImages[scene.photoKey] : undefined}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 6rem;
  }

  .hero-band .container {
    position: relative;
    z-index: 1;
  }

  .hero-band__intro {
    position: relative;
  }

  .hero-band__accent {
    color: var(--color-blood-bright);
  }

  .stats-block {
    margin-top: 2rem;
  }

  .trail-card h3 {
    margin-bottom: 0.5rem;
  }

  .trail-card--intense {
    border-color: var(--color-blood);
  }
</style>
