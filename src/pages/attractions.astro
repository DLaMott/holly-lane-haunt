---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatBadge from "../components/StatBadge.astro";
import SceneCard from "../components/SceneCard.astro";
import { stats, scenes } from "../data/site";

import crowleysCrypt from "../assets/scenes/crowleys_crypt.jpg";
import witchShack from "../assets/scenes/witch_shack.jpg";
import clownMaze from "../assets/scenes/clown_maze.jpg";
import fungalTrail from "../assets/scenes/fungal_trail.jpg";

const sceneImages: Record<string, ImageMetadata> = {
  crowleysCrypt,
  witchShack,
  clownMaze,
  fungalTrail,
};
---

<BaseLayout
  title="Attractions"
  description="13 scenes, 100+ animatronics, and 30 live scarers. Explore what's waiting on The Holly Lane Haunt trail."
>
  <section class="section hero-band">
    <div class="container">
      <p class="eyebrow">The Trail</p>
      <h1>13 Scenes. Zero Mercy.</h1>
      <p class="section-lead">
        From a gentle welcome to a full-blown gauntlet of animatronics and live scarers, here's what
        awaits on the trail.
      </p>
      <div class="grid grid--stats stats-block">
        {stats.map((stat) => <StatBadge label={stat.label} value={stat.value} />)}
      </div>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container grid grid--2">
      <div class="card trail-card">
        <h3>🎃 Front Trail</h3>
        <p>
          A friendlier, well-lit experience built with younger trick-or-treaters in mind, including a
          dedicated inflatable trail just for them. Great for first-timers and little ones.
        </p>
      </div>
      <div class="card trail-card trail-card--intense">
        <h3>🔪 Back Trail</h3>
        <p>
          The full haunt experience: fog, strobes, tight spaces, and scarers who mean business. Not
          recommended for young children or anyone who scares easily.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Scene By Scene</p>
      <h2>What's Waiting For You</h2>
      <div class="grid grid--scenes">
        {scenes.map((scene) => (
          <SceneCard
            number={scene.number}
            name={scene.name}
            description={scene.description}
            image={scene.photoKey ? sceneImages[scene.photoKey] : undefined}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .stats-block {
    margin-top: 2rem;
  }

  .trail-card h3 {
    margin-bottom: 0.5rem;
  }

  .trail-card--intense {
    border-color: var(--color-blood);
  }
</style>
